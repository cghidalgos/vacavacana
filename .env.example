# Clave de la API de Claude. Consíguela en https://console.anthropic.com/settings/keys
# Pega la tuya aquí (empieza por sk-ant-). Sin ella, el resto de la app funciona
# igual pero el asistente responde 503.
ANTHROPIC_API_KEY=

# Modelo del asistente. claude-opus-5 es el más capaz; claude-sonnet-5 es más
# económico si el chat se usa mucho.
ANTHROPIC_MODEL=claude-opus-5

# Puertos expuestos en tu máquina. Cámbialos si ya están ocupados.
FRONTEND_PORT=3000
BACKEND_PORT=8001
